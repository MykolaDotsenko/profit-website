{
  "name": "profit-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "PROFIT public company website — provisional B2 Production Unit Grammar implementation (Astro, static output).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "verify": "npm run design:check && npm run claims:check && npm run scorecard:check && npm run evidence:check && npm run deploy:check && astro check && npm test && astro build",
    "design:check": "node scripts/validate_design_system.mjs",
    "claims:check": "node scripts/validate_claim_hygiene.mjs",
    "scorecard:check": "node scripts/validate_website_scorecard.mjs",
    "evidence:check": "node scripts/validate_release_evidence.mjs",
    "deploy:check": "node scripts/validate_deployment_contract.mjs"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
