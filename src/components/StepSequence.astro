---
/**
 * Data → Economics → Decision → Action → Measurement (Blueprint §5, WWW-204). Static by design:
 * the order and the actor carry the meaning, not motion.
 */
import type { Actor, Step } from '../content/types';

interface Props {
  steps: Step[];
  actors: Record<Actor, string>;
  moduleLabel: string;
}

const { steps, actors, moduleLabel } = Astro.props;
---

<ol class="steps" role="list" data-brand-code="decision-lineage">
  {
    steps.map((step, i) => (
      <li class:list={['step', `step--${step.actor}`]}>
        <p class="step__meta">
          <span class="step__number num">{String(i + 1).padStart(2, '0')}</span>
          <span class="step__actor">{actors[step.actor]}</span>
        </p>
        <h3 class="step__title">{step.title}</h3>
        <p class="step__text">{step.text}</p>
        {step.module && (
          <p class="step__module">
            <span class="step__module-label">{moduleLabel}</span> {step.module}
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  @layer components {
    .steps {
      display: grid;
      border-block: 1px solid var(--color-line-strong);
    }

    .step {
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr);
      column-gap: var(--space-4);
      row-gap: var(--space-2);
      align-content: start;
      min-width: 0;
      padding-block: var(--space-5);
    }

    .step + .step {
      border-block-start: 1px solid var(--color-line);
    }

    .step__meta {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 3rem auto minmax(1rem, 1fr);
      gap: var(--space-4);
      align-items: center;
      min-width: 0;
      color: var(--color-text-secondary);
    }

    .step__meta::after {
      content: '';
      height: 1px;
      background: var(--color-line);
    }

    .step__number {
      font-family: var(--font-label);
      font-size: var(--text-small);
      font-weight: var(--weight-strong);
      color: var(--color-production);
    }

    .step__actor {
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .step--profit .step__actor {
      color: var(--color-text);
    }

    .step__title,
    .step__text,
    .step__module {
      grid-column: 2;
    }

    .step__title {
      font-size: var(--text-subsection);
      line-height: 1.25;
    }

    .step__text {
      color: var(--color-text-secondary);
    }

    .step__module {
      padding-block-start: var(--space-2);
      font-size: var(--text-small);
      color: var(--color-text-secondary);
    }

    .step__module-label {
      display: block;
      margin-block-end: var(--space-1);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    @container (min-width: 56rem) {
      .steps {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }

      .step {
        grid-template-columns: 1fr;
        padding: var(--space-5) var(--space-4) var(--space-6);
      }

      .step + .step {
        border-block-start: 0;
        border-inline-start: 1px solid var(--color-line);
      }

      .step__meta {
        grid-template-columns: auto auto minmax(1rem, 1fr);
        gap: var(--space-3);
      }

      .step__title,
      .step__text,
      .step__module {
        grid-column: 1;
      }
    }
  }
</style>
