---
/**
 * Field Profitability exhibit: fields side by side (the saved-snapshots list, Blueprint §2.2)
 * and the composition of one field's operating profit. Always a labelled illustration.
 */
import EvidenceLabel from './EvidenceLabel.astro';
import Metric from './Metric.astro';
import SourceLine from './SourceLine.astro';
import { fieldLabel, fieldParts } from './fieldLabel';
import { focusField, type FieldSeasonExample } from '../content/examples/field-season';
import { localeInfo, ui } from '../i18n';

interface Props {
  example: FieldSeasonExample;
  labels: {
    productName: string;
    notScreenshot: string;
    tableCaption: string;
    columnField: string;
    columnPerHa: string;
    columnTotal: string;
    compositionTitle: string;
    breakEvenAtYield: string;
    breakEvenAtPrice: string;
    definition: string;
    decision: string;
    question: string;
    decisionNote: string;
    records: string;
    lineage: readonly { title: string; text: string }[];
  };
}

const { example, labels } = Astro.props;
const locale = localeInfo(Astro.currentLocale);
const t = ui(locale.code);
const f = focusField(example);
const cur = example.currency;
const money = (metric: 'revenue' | 'variable_costs' | 'allocated_fixed_costs' | 'operating_costs' | 'operating_profit', amount: number) => ({
  metric,
  amount,
  currency: cur,
  perArea: 'ha' as const,
});
const rows = [
  { op: '', label: t.metrics.yield, value: { metric: 'yield' as const, amount: f.inputs.yieldPerHa, mass: 't' as const, perArea: 'ha' as const } },
  { op: '×', label: t.metrics.price, value: { metric: 'price' as const, amount: f.inputs.pricePerT, currency: cur, perMass: 't' as const } },
  { op: '=', label: t.metrics.revenue, value: money('revenue', f.economics.revenuePerHa), subtotal: true },
  { op: '−', label: t.metrics.variable_costs, value: money('variable_costs', f.inputs.variableCostsPerHa) },
  { op: '−', label: t.metrics.allocated_fixed_costs, value: money('allocated_fixed_costs', f.inputs.allocatedFixedCostsPerHa) },
];
const result = money('operating_profit', f.economics.operatingProfitPerHa);
---

<figure class="field-example" data-brand-code="economic-state-proof">
  <div class="field-example__frame">
    <aside class="field-example__rail" aria-label={`${t.evidence.exampleLabel}: ${fieldLabel(f, t, locale.intl)}`}>
      <div class="field-example__rail-top">
        <p class="field-example__rail-label">{t.production.currentUnit}</p>
        <p class="field-example__rail-name">{fieldParts(f, t, locale.intl).name}</p>
        <p class="field-example__rail-detail">{fieldParts(f, t, locale.intl).detail}</p>
      </div>

      <div class="field-example__rail-meta">
        <EvidenceLabel meta={example.meta} />
        <p class="field-example__note">{labels.notScreenshot}</p>
      </div>

      <dl class="field-example__rail-facts">
        <div>
          <dt>{t.production.productLabel}</dt>
          <dd>{labels.productName}</dd>
        </div>
        <div>
          <dt>{t.production.periodLabel}</dt>
          <dd>{t.seasons(1)}</dd>
        </div>
        <div>
          <dt>{t.production.roleLabel}</dt>
          <dd>{t.production.currentExample}</dd>
        </div>
      </dl>
    </aside>

    <div class="field-example__main">
      <div class="field-example__state" aria-label={t.production.economicState}>
        <div>
          <p class="field-example__state-label">{t.production.economicState}</p>
          <p class="field-example__state-context">{fieldLabel(f, t, locale.intl)} · {t.seasons(1)}</p>
        </div>
        <div class="field-example__state-value">
          <Metric value={result} size="l" signal />
          <span>{t.metrics.operating_profit}</span>
        </div>
        <p class="field-example__state-note">{labels.definition}</p>
      </div>

      <ol class="field-example__lineage" aria-label="Production record to farmer decision">
        {labels.lineage.map((step, i) => (
          <li>
            <span class="field-example__lineage-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="field-example__lineage-copy">
              <strong>{step.title}</strong>
              <small>{step.text}</small>
            </span>
          </li>
        ))}
      </ol>

      <div class="field-example__grid">
        <div class="field-example__panel field-example__panel--compare">
          <div class="snapshot-wrap" tabindex="0" role="region" aria-label={labels.tableCaption}>
            <table class="snapshot">
            <caption>{labels.tableCaption}</caption>
            <thead>
              <tr>
                <th scope="col">{labels.columnField}</th>
                <th scope="col">{labels.columnPerHa}</th>
                <th scope="col">{labels.columnTotal}</th>
              </tr>
            </thead>
            <tbody>
              {
                example.fields.map((field) => (
                  <tr class:list={{ 'is-focus': field.id === example.focusFieldId }}>
                    <th scope="row">
                      <span class="field-name">{fieldParts(field, t, locale.intl).name}</span>
                      <span class="field-detail">{fieldParts(field, t, locale.intl).detail}</span>
                    </th>
                    <td>
                      <Metric value={money('operating_profit', field.operatingProfitPerHa)} size="m" signal />
                    </td>
                    <td>
                      <Metric value={{ metric: 'operating_profit', amount: field.operatingProfitPerHa * field.areaHa, currency: cur }} signal />
                    </td>
                  </tr>
                ))
              }
            </tbody>
            </table>
          </div>
        </div>

        <div class="field-example__panel field-example__panel--economics">
          <table class="composition">
            <caption>{labels.compositionTitle.replace('{field}', fieldLabel(f, t, locale.intl))}</caption>
            <tbody>
              {
                rows.map((row) => (
                  <tr class:list={{ 'is-subtotal': row.subtotal }}>
                    <td class="composition__op" aria-hidden="true">{row.op}</td>
                    <th scope="row">{row.label}</th>
                    <td>
                      <Metric value={row.value} />
                    </td>
                  </tr>
                ))
              }
              <tr class="is-result">
                <td class="composition__op" aria-hidden="true">=</td>
                <th scope="row">{t.metrics.operating_profit}</th>
                <td>
                  <Metric value={result} size="m" signal />
                </td>
              </tr>
            </tbody>
          </table>

          <dl class="break-even">
            <div>
              <dt>{t.metrics.break_even_price}</dt>
              <dd>
                <Metric value={{ metric: 'break_even_price', amount: f.economics.breakEvenPrice, currency: cur, perMass: 't' }} />
                <span class="break-even__at">{labels.breakEvenAtYield}</span>
              </dd>
            </div>
            <div>
              <dt>{t.metrics.break_even_yield}</dt>
              <dd>
                <Metric value={{ metric: 'break_even_yield', amount: f.economics.breakEvenYield, mass: 't', perArea: 'ha' }} />
                <span class="break-even__at">{labels.breakEvenAtPrice}</span>
              </dd>
            </div>
          </dl>

          <p class="field-example__definition">{labels.definition}</p>
        </div>
      </div>

      <div class="field-example__decision">
        <div>
          <p class="field-example__decision-label">{labels.decision}</p>
          <p class="field-example__question">{labels.question}</p>
        </div>
        <p class="field-example__decision-note">{labels.decisionNote}</p>
      </div>

      <figcaption>
        <SourceLine meta={example.meta} period={example.period} records={labels.records} />
      </figcaption>
    </div>
  </div>
</figure>

<style>
  @layer components {
    .field-example {
      container-type: inline-size;
    }

    .field-example__frame {
      display: grid;
      border: 1px solid var(--color-line-strong);
      background: var(--color-line-strong);
      gap: 1px;
    }

    .field-example__rail,
    .field-example__main {
      min-width: 0;
      background: var(--color-surface);
    }

    .field-example__rail {
      display: grid;
      gap: var(--space-5);
      align-content: start;
      padding: var(--space-5);
      background: var(--color-production-rail);
    }

    .field-example__rail-top,
    .field-example__rail-meta {
      display: grid;
      gap: var(--space-2);
    }

    .field-example__rail-label,
    .field-example__decision-label {
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .field-example__rail-name {
      font-size: var(--text-subsection);
      font-weight: var(--weight-strong);
      line-height: 1.2;
    }

    .field-example__rail-detail,
    .field-example__note {
      color: var(--color-text-secondary);
      font-size: var(--text-caption);
      line-height: 1.5;
    }

    .field-example__rail-facts {
      display: grid;
      border-block-start: 1px solid var(--color-line);
    }

    .field-example__rail-facts > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-3);
      padding-block: var(--space-3);
      border-block-end: 1px solid var(--color-line);
    }

    .field-example__rail-facts dt {
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-caption);
    }

    .field-example__rail-facts dd {
      text-align: end;
      font-size: var(--text-small);
      font-weight: var(--weight-strong);
    }

    .field-example__main {
      display: grid;
      gap: 1px;
      background: var(--color-line-strong);
    }

    .field-example__state {
      display: grid;
      gap: var(--space-4);
      align-items: end;
      padding: clamp(1.25rem, 0.9rem + 1.6vw, 2rem);
      background: var(--color-production-surface);
    }

    .field-example__state-label,
    .field-example__state-value span {
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .field-example__state-context,
    .field-example__state-note {
      color: var(--color-text-secondary);
      font-size: var(--text-small);
      line-height: 1.5;
    }

    .field-example__state-value {
      display: grid;
      gap: var(--space-1);
      justify-items: start;
    }

    .field-example__state-value :global(.metric--l) {
      font-size: clamp(3.25rem, 2.4rem + 4vw, 6rem);
      line-height: 0.92;
      letter-spacing: -0.055em;
    }

    .field-example__state-note {
      max-width: var(--measure);
    }

    .field-example__lineage {
      display: grid;
      gap: 1px;
      background: var(--color-line);
    }

    .field-example__lineage li {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: var(--space-3);
      align-items: start;
      padding: var(--space-3) var(--space-4);
      background: var(--color-surface);
    }

    .field-example__lineage-index {
      color: var(--color-production);
      font-family: var(--font-label);
      font-size: var(--text-caption);
      font-weight: var(--weight-strong);
    }

    .field-example__lineage-copy strong,
    .field-example__lineage-copy small {
      display: block;
    }

    .field-example__lineage-copy strong {
      font-size: var(--text-small);
      line-height: 1.3;
    }

    .field-example__lineage-copy small {
      margin-block-start: var(--space-1);
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-label);
      line-height: 1.35;
    }

    .field-example__grid {
      display: grid;
      gap: 1px;
      background: var(--color-line-strong);
    }

    .field-example__panel,
    .field-example__decision,
    figcaption {
      min-width: 0;
      padding: clamp(1rem, 0.7rem + 1vw, 1.5rem);
      background: var(--color-surface);
    }

    .field-example__panel--economics {
      background: var(--color-production-surface);
    }

    .snapshot-wrap {
      width: 100%;
      min-width: 0;
      max-width: 100%;
      contain: inline-size;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
    }

    .snapshot-wrap:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }

    table {
      width: 100%;
    }

    .snapshot {
      min-width: 18rem;
    }

    caption {
      caption-side: top;
      text-align: start;
      font-family: var(--font-label);
      font-weight: var(--weight-strong);
      font-size: var(--text-label);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      padding-block-end: var(--space-3);
    }

    .snapshot thead th {
      font-size: var(--text-caption);
      font-weight: var(--weight-medium);
      color: var(--color-text-secondary);
      text-align: end;
      padding-block: var(--space-2);
      border-block-end: 1px solid var(--color-line-strong);
      vertical-align: bottom;
    }

    .snapshot thead th:first-child {
      text-align: start;
    }

    .snapshot tbody th {
      text-align: start;
      font-weight: var(--weight-regular);
      font-size: var(--text-small);
      padding-block: var(--space-4);
      padding-inline-end: var(--space-3);
    }

    .snapshot td {
      text-align: end;
      padding-block: var(--space-4);
      padding-inline-start: var(--space-3);
      vertical-align: baseline;
    }

    .snapshot tbody tr + tr {
      border-block-start: 1px solid var(--color-line);
    }

    .snapshot tbody tr.is-focus {
      background: color-mix(in srgb, var(--color-production-surface) 72%, var(--color-surface));
    }

    .snapshot tbody tr.is-focus th,
    .snapshot tbody tr.is-focus td {
      padding-inline: var(--space-3);
    }

    .field-name {
      display: block;
    }

    .field-detail {
      display: block;
      font-size: var(--text-caption);
      color: var(--color-text-secondary);
    }

    .snapshot tr.is-focus .field-name {
      font-weight: var(--weight-strong);
    }

    .composition th {
      text-align: start;
      font-weight: var(--weight-regular);
      font-size: var(--text-small);
      padding-block: var(--space-2);
    }

    .composition td {
      text-align: end;
      padding-block: var(--space-2);
    }

    .composition__op {
      width: 1.5rem;
      text-align: start !important;
      color: var(--color-text-secondary);
      font-family: var(--font-numeric);
    }

    .composition tr.is-subtotal th,
    .composition tr.is-subtotal td {
      padding-block-end: var(--space-3);
    }

    .composition tr.is-subtotal + tr th,
    .composition tr.is-subtotal + tr td {
      border-block-start: 1px solid var(--color-line);
      padding-block-start: var(--space-3);
    }

    .composition tr.is-result th,
    .composition tr.is-result td {
      border-block-start: 2px solid var(--color-line-strong);
      padding-block-start: var(--space-3);
      font-weight: var(--weight-strong);
    }

    .break-even {
      display: grid;
      gap: var(--space-2);
      margin-block-start: var(--space-4);
      padding-block-start: var(--space-4);
      border-block-start: 1px solid var(--color-line);
    }

    .break-even div {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-1) var(--space-3);
    }

    .break-even dt {
      font-size: var(--text-small);
    }

    .break-even dd {
      text-align: end;
    }

    .break-even__at {
      display: block;
      font-size: var(--text-caption);
      color: var(--color-text-secondary);
    }

    .field-example__definition {
      margin-block-start: var(--space-4);
      font-size: var(--text-caption);
      color: var(--color-text-secondary);
    }

    .field-example__decision {
      display: grid;
      gap: var(--space-4);
      border-inline-start: 0.35rem solid var(--color-production);
    }

    .field-example__question {
      margin-block-start: var(--space-2);
      max-width: 27ch;
      font-size: var(--text-subsection);
      font-weight: var(--weight-strong);
      line-height: 1.28;
    }

    .field-example__decision-note {
      max-width: var(--measure);
      color: var(--color-text-secondary);
      font-size: var(--text-small);
      line-height: 1.5;
    }

    figcaption {
      color: var(--color-text-secondary);
    }

    @container (min-width: 54rem) {
      .field-example__frame {
        grid-template-columns: minmax(12rem, 2.5fr) minmax(0, 9.5fr);
      }

      .field-example__rail {
        align-content: space-between;
      }

      .field-example__state {
        grid-template-columns: minmax(0, 4fr) minmax(14rem, 3fr) minmax(0, 5fr);
      }

      .field-example__state-value {
        justify-items: end;
        text-align: end;
      }

      .field-example__lineage {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .field-example__grid {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      }

      .field-example__decision {
        grid-template-columns: minmax(0, 7fr) minmax(16rem, 5fr);
        align-items: end;
      }
    }
  }
</style>
