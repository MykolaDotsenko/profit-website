---
/** Hard questions as native disclosures: readable without JavaScript, keyboard-operable. */
import ContentGap from './ContentGap.astro';
import type { Question } from '../content/types';

interface Props {
  questions: Question[];
  /** Heading level for each question. */
  level?: 3 | 4;
}

const { questions, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
---

<div class="questions">
  {
    questions.map((q) => (
      <details class="question" id={q.id}>
        <summary>
          <Heading class="question__title">{q.question}</Heading>
        </summary>
        <div class="question__answer stack">
          {q.answer.map((para) => (
            <p>{para}</p>
          ))}
          {q.review && <ContentGap owner={q.review.owner} kind="review" text={q.review.text} />}
        </div>
      </details>
    ))
  }
</div>

<style>
  @layer components {
    .questions {
      border: 1px solid var(--color-line-strong);
      background: var(--color-surface);
    }
    .question + .question {
      border-block-start: 1px solid var(--color-line);
    }
    .question summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-5);
      cursor: pointer;
      list-style: none;
    }
    .question summary::-webkit-details-marker {
      display: none;
    }
    .question summary::after {
      content: '+';
      flex: none;
      width: 1.75rem;
      height: 1.75rem;
      display: grid;
      place-items: center;
      border: 1px solid var(--color-control-border);
      border-radius: var(--radius-s);
      font-size: 1.125rem;
      line-height: 1;
    }
    .question[open] summary::after {
      content: '−';
    }
    .question__title {
      font-size: var(--text-subsection);
      font-weight: var(--weight-strong);
      line-height: 1.35;
    }
    .question__answer {
      padding: 0 var(--space-5) var(--space-5);
      max-width: var(--measure-wide);
      color: var(--color-text-secondary);
    }
  }
</style>
