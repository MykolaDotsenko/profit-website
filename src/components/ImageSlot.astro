---
/**
 * Documentary image slot. Until an approved asset with source, rights and provenance exists,
 * it renders an honest placeholder instead of stock or synthetic imagery (D8 rule, Blueprint §7).
 * Supplying `image` swaps in the photograph without layout changes; width/height and the
 * aspect ratio reserve space, so the swap cannot cause layout shift.
 */
import { localeInfo, ui } from '../i18n';
interface ImageAsset {
  src: string;
  srcset?: string;
  sizes?: string;
  width: number;
  height: number;
  alt: string;
  /** Required: who made it, where, and under what rights. */
  credit: string;
}

interface Props {
  caption: string;
  requirement: string;
  aspect?: '4/5' | '3/2' | '16/9' | '1/1';
  image?: ImageAsset;
  /** Only for an above-the-fold (LCP) image. */
  priority?: boolean;
  class?: string;
}

const { caption, requirement, aspect = '3/2', image, priority = false, class: className } = Astro.props;
const t = ui(localeInfo(Astro.currentLocale).code);
---

<figure class:list={['image-slot', className]} style={`--slot-aspect: ${aspect}`}>
  {
    image ? (
      <img
        src={image.src}
        srcset={image.srcset}
        sizes={image.sizes}
        width={image.width}
        height={image.height}
        alt={image.alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    ) : (
      <div class="image-slot__placeholder">
        <span class="image-slot__tag">{t.status.imagePending}</span>
      </div>
    )
  }
  <figcaption class="image-slot__caption">
    <span>{caption}</span>
    <span class="image-slot__credit">{image ? image.credit : requirement}</span>
  </figcaption>
</figure>

<style>
  @layer components {
    .image-slot {
      display: grid;
      gap: var(--space-2);
      margin: 0;
    }
    .image-slot img,
    .image-slot__placeholder {
      width: 100%;
      aspect-ratio: var(--slot-aspect);
      object-fit: cover;
    }
    .image-slot__placeholder {
      position: relative;
      background-color: var(--color-surface-sunken);
      background-image: repeating-linear-gradient(
        135deg,
        transparent 0 11px,
        color-mix(in srgb, var(--color-line) 70%, transparent) 11px 12px
      );
      border: 1px solid var(--color-line);
    }
    .image-slot__tag {
      position: absolute;
      inset-block-start: var(--space-3);
      inset-inline-start: var(--space-3);
      padding: 0.2rem 0.45rem;
      background: var(--color-canvas);
      border: 1px solid var(--color-line);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-secondary);
    }
    .image-slot__caption {
      display: grid;
      gap: 0.125rem;
      font-size: var(--text-caption);
      line-height: 1.45;
      color: var(--color-text-secondary);
    }
    .image-slot__caption > span:first-child {
      color: var(--color-text);
      font-weight: var(--weight-medium);
    }
  }
</style>
