---
/**
 * Documentary image slot. Until an approved asset with source, rights and provenance exists,
 * it renders an honest placeholder instead of stock or synthetic imagery (D8 rule, Blueprint §7).
 * Supplying `image` swaps in the photograph without layout changes; width/height and the
 * aspect ratio reserve space, so the swap cannot cause layout shift.
 */
import type { ImageAsset } from '../content/types';
import { localeInfo, ui } from '../i18n';

interface Props {
  caption: string;
  requirement: string;
  aspect?: '4/5' | '3/2' | '16/9' | '1/1';
  image?: ImageAsset;
  /** Only for an above-the-fold (LCP) image. */
  priority?: boolean;
  class?: string;
}

const { caption, requirement, aspect = '3/2', image, priority = false, class: className } = Astro.props;
const t = ui(localeInfo(Astro.currentLocale).code);
---

<figure class:list={['image-slot', className]} style={`--slot-aspect: ${aspect}`}>
  {
    image ? (
      <img
        src={image.src}
        srcset={image.srcset}
        sizes={image.sizes}
        width={image.width}
        height={image.height}
        alt={image.alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    ) : (
      <div class="image-slot__placeholder">
        <span class="image-slot__tag">{t.status.imagePending}</span>
        <span class="image-slot__placeholder-title">{t.status.documentaryAgriculture}</span>
      </div>
    )
  }
  <figcaption class="image-slot__caption">
    <span>{caption}</span>
    <span class="image-slot__credit">{image ? image.credit : requirement}</span>
  </figcaption>
</figure>

<style>
  @layer components {
    .image-slot {
      display: grid;
      gap: var(--space-2);
      margin: 0;
    }
    .image-slot img,
    .image-slot__placeholder {
      width: 100%;
      aspect-ratio: var(--slot-aspect);
      object-fit: cover;
    }
    .image-slot__placeholder {
      position: relative;
      display: flex;
      align-items: end;
      padding: var(--space-4);
      background: var(--color-production-rail);
      border: 1px solid var(--color-line-strong);
    }
    .image-slot__placeholder::before {
      content: '';
      position: absolute;
      inset: var(--space-4);
      border-inline-start: 1px solid var(--color-line);
      border-block-end: 1px solid var(--color-line);
      pointer-events: none;
    }
    .image-slot__placeholder-title {
      position: relative;
      max-width: 12ch;
      font-size: var(--text-subsection);
      font-weight: var(--weight-strong);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
    .image-slot__tag {
      position: absolute;
      inset-block-start: var(--space-3);
      inset-inline-start: var(--space-3);
      padding: 0.2rem 0.45rem;
      background: var(--color-surface);
      border: 1px solid var(--color-line-strong);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-secondary);
    }
    .image-slot__caption {
      display: grid;
      gap: 0.125rem;
      font-size: var(--text-caption);
      line-height: 1.45;
      color: var(--color-text-secondary);
    }
    .image-slot__caption > span:first-child {
      color: var(--color-text);
      font-weight: var(--weight-medium);
    }
  }
</style>
