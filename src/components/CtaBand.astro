---
/** Closing call to action that says exactly what happens after the click (Blueprint §5 11). */
import ContentGap from './ContentGap.astro';
import Section from './Section.astro';
import type { ContentGap as Gap, Cta, SectionIntro, TextItem } from '../content/types';
import { localeInfo, localePath } from '../i18n';

interface Props {
  intro: SectionIntro;
  stepsTitle: string;
  steps: TextItem[];
  review?: Gap;
  primary: Cta;
  secondary?: Cta;
}

const { intro, stepsTitle, steps, review, primary, secondary } = Astro.props;
const locale = localeInfo(Astro.currentLocale).code;
const href = (cta: Cta) => (cta.href.startsWith('#') ? cta.href : localePath(locale, cta.href));
---

<Section intro={intro} layout="split" tone="inverse" class="cta-band">
  <div class="cta-band__body" data-brand-code="qualified-next-step">
    <h3 class="cta-band__steps-title">{stepsTitle}</h3>
    <ol class="cta-band__steps" role="list">
      {
        steps.map((step, i) => (
          <li>
            <span class="cta-band__index num" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <p class="cta-band__step-title">{step.title}</p>
              <p class="cta-band__step-text">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    {review && <ContentGap owner={review.owner} kind="review" tone="inverse" text={review.text} />}
    <div class="cta-band__actions">
      <a class="button button--primary" href={href(primary)}>{primary.label}</a>
      {secondary && <a class="text-link" href={href(secondary)}>{secondary.label}</a>}
    </div>
  </div>
</Section>

<style>
  @layer components {
    .cta-band__body {
      display: grid;
      gap: var(--space-5);
      max-width: none;
    }

    .cta-band__steps-title {
      font-family: var(--font-label);
      font-size: var(--text-label);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-inverse-secondary);
    }

    .cta-band__steps {
      display: grid;
      border-block: 1px solid var(--color-inverse-line);
    }

    .cta-band__steps li {
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    .cta-band__steps li + li {
      border-block-start: 1px solid var(--color-inverse-line);
    }

    .cta-band__index {
      font-family: var(--font-label);
      font-weight: var(--weight-strong);
      font-size: var(--text-caption);
      line-height: 1.5;
      color: var(--color-inverse-secondary);
    }

    .cta-band__step-title {
      font-weight: var(--weight-strong);
    }

    .cta-band__step-text {
      margin-block-start: var(--space-1);
      color: var(--color-inverse-secondary);
      font-size: var(--text-small);
    }

    .cta-band__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-6);
      padding-block-start: var(--space-4);
      border-block-start: 1px solid var(--color-inverse-line);
    }

    .cta-band__actions .button--primary {
      background: var(--color-inverse-text);
      color: var(--color-inverse-canvas);
      border-color: var(--color-inverse-text);
    }

    .cta-band__actions .button--primary:hover {
      background: var(--paper-300);
    }

    .cta-band__actions .text-link {
      color: var(--color-inverse-text);
    }

    @container (min-width: 50rem) {
      .cta-band__steps {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .cta-band__steps li {
        grid-template-columns: 2rem minmax(0, 1fr);
        padding-inline: var(--space-4);
      }

      .cta-band__steps li:first-child {
        padding-inline-start: 0;
      }

      .cta-band__steps li:last-child {
        padding-inline-end: 0;
      }

      .cta-band__steps li + li {
        border-block-start: 0;
        border-inline-start: 1px solid var(--color-inverse-line);
      }
    }
  }
</style>
