---
/**
 * Marks content that must come from the PROFIT team (or legal/domain review), not from AI
 * drafting. Rendered only while SHOW_CONTENT_STATUS is on. Every gap is also listed in README.md.
 */
import { site } from '../config/site';
import { localeInfo, ui } from '../i18n';
import type { GapOwner } from '../content/types';

interface Props {
  owner: GapOwner;
  /** 'gap' = content missing; 'review' = drafted text that needs confirmation. */
  kind?: 'gap' | 'review';
  tone?: 'default' | 'inverse';
  text?: string;
}

const { owner, kind = 'gap', tone = 'default', text } = Astro.props;
const t = ui(localeInfo(Astro.currentLocale).code);
const ownerLabel: Record<GapOwner, string> = {
  owner: 'PROFIT team',
  legal: 'legal review',
  domain: 'domain expert',
  product: 'product owner',
};
const label = kind === 'gap' ? t.status.gapLabel : t.status.reviewLabel;
---

{
  site.showContentStatus && (
    <div class:list={['content-gap', `content-gap--${tone}`]} role="note">
      <span class="content-gap__label">
        {label} · {ownerLabel[owner]}
      </span>
      <span class="content-gap__text">{text ? text : <slot />}</span>
    </div>
  )
}

<style>
  @layer components {
    .content-gap {
      display: grid;
      gap: var(--space-1);
      max-width: var(--measure-wide);
      padding: var(--space-3) var(--space-4);
      border: 1px dashed var(--color-gap-line);
      border-radius: var(--radius-m);
      background: var(--color-gap-bg);
      color: var(--ink-950);
      font-size: var(--text-caption);
      line-height: 1.5;
    }
    .content-gap__label {
      font-weight: var(--weight-strong);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-size: 0.6875rem;
      color: var(--amber-700);
    }
    .content-gap--inverse {
      background: transparent;
      border-color: var(--color-inverse-secondary);
      color: var(--color-inverse-text);
    }
    .content-gap--inverse .content-gap__label {
      color: var(--color-inverse-secondary);
    }
  }
</style>
