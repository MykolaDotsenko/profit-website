---
/** Titled operational records in the provisional B2 production-unit grammar. */
import type { TextItem } from '../content/types';

interface Props {
  items: TextItem[];
  columns?: 1 | 2 | 3;
  /** Heading level for item titles. */
  level?: 3 | 4;
  marker?: 'none' | 'number' | 'cross';
  /** 'rows' keeps title and explanation in a ledger-like record on wide screens. */
  layout?: 'grid' | 'rows';
}

const { items, columns = 2, level = 3, marker = 'none', layout = 'grid' } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
---

<ul class:list={['items', `items--${columns}`, `items--${marker}`, `items--${layout}`]} role="list">
  {
    items.map((item, i) => (
      <li class="item">
        {marker === 'number' && (
          <span class="item__marker num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        )}
        {marker === 'cross' && (
          <span class="item__marker" aria-hidden="true">
            ×
          </span>
        )}
        <Heading class="item__title">{item.title}</Heading>
        {item.text && <p class="item__text">{item.text}</p>}
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .items {
      display: grid;
      gap: 1px;
      background: var(--color-line);
      border: 1px solid var(--color-line);
    }
    .item {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: var(--space-3);
      row-gap: var(--space-1);
      align-content: start;
      min-width: 0;
      padding: var(--space-4);
      background: var(--color-surface);
    }
    .items--none .item {
      grid-template-columns: 1fr;
    }
    .item__marker {
      grid-row: span 2;
      font-size: var(--text-caption);
      font-weight: var(--weight-strong);
      color: var(--color-production);
      font-family: var(--font-label);
      padding-block-start: 0.2em;
    }
    .item__title {
      font-size: var(--text-body);
      font-weight: var(--weight-strong);
      line-height: 1.4;
    }
    .item__text {
      font-size: var(--text-small);
      color: var(--color-text-secondary);
    }
    @container (min-width: 34rem) {
      .items--grid.items--2,
      .items--grid.items--3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @container (min-width: 44rem) {
      .items--rows .item {
        grid-template-columns: auto minmax(10rem, 3fr) minmax(0, 6fr);
        align-items: baseline;
      }
      .items--rows.items--none .item {
        grid-template-columns: minmax(10rem, 3fr) minmax(0, 6fr);
      }
      .items--rows .item__marker {
        grid-row: auto;
      }
      .items--rows .item__text {
        grid-column: auto;
      }
    }

    @container (min-width: 56rem) {
      .items--grid.items--3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  }
</style>
