---
/** Titled items in an editorial ruled grid (not cards). */
import type { TextItem } from '../content/types';

interface Props {
  items: TextItem[];
  columns?: 1 | 2 | 3;
  /** Heading level for item titles. */
  level?: 3 | 4;
  marker?: 'none' | 'number' | 'cross';
}

const { items, columns = 2, level = 3, marker = 'none' } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
---

<ul class:list={['items', `items--${columns}`, `items--${marker}`]} role="list">
  {
    items.map((item, i) => (
      <li class="item">
        {marker === 'number' && (
          <span class="item__marker num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        )}
        {marker === 'cross' && (
          <span class="item__marker" aria-hidden="true">
            ×
          </span>
        )}
        <Heading class="item__title">{item.title}</Heading>
        {item.text && <p class="item__text">{item.text}</p>}
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .items {
      display: grid;
      gap: 0 var(--space-6);
    }
    .item {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: var(--space-3);
      row-gap: var(--space-1);
      align-content: start;
      padding-block: var(--space-4);
      border-block-start: 1px solid var(--color-line);
    }
    .items--none .item {
      grid-template-columns: 1fr;
    }
    .item__marker {
      grid-row: span 2;
      font-size: var(--text-caption);
      font-weight: var(--weight-strong);
      color: var(--color-text-secondary);
      padding-block-start: 0.2em;
    }
    .item__title {
      font-size: var(--text-body);
      font-weight: var(--weight-strong);
      line-height: 1.4;
    }
    .item__text {
      font-size: var(--text-small);
      color: var(--color-text-secondary);
    }
    @container (min-width: 34rem) {
      .items--2,
      .items--3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @container (min-width: 56rem) {
      .items--3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  }
</style>
