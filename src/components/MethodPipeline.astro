---
interface Step {
  title: string;
  text: string;
  state?: string;
}

interface Props {
  steps: readonly Step[];
  ariaLabel: string;
}

const { steps, ariaLabel } = Astro.props;
---

<ol class="method-pipeline" aria-label={ariaLabel} data-brand-code="operational-ledger">
  {steps.map((step, index) => (
    <li class="method-pipeline__step">
      <div class="method-pipeline__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
      <div class="method-pipeline__head">
        <h3>{step.title}</h3>
        {step.state && <span class="method-pipeline__state">{step.state}</span>}
      </div>
      <p>{step.text}</p>
    </li>
  ))}
</ol>

<style>
  @layer components {
    .method-pipeline {
      display: grid;
      border-block: 1px solid var(--color-line-strong);
    }

    .method-pipeline__step {
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: var(--space-3) var(--space-4);
      min-width: 0;
      padding-block: var(--space-5);
      color: var(--color-text);
    }

    .method-pipeline__step + .method-pipeline__step {
      border-block-start: 1px solid var(--color-line);
    }

    .method-pipeline__index {
      grid-row: 1 / span 2;
      padding-block-start: 0.2rem;
      color: var(--color-production);
      font-family: var(--font-label);
      font-size: var(--text-small);
      font-weight: var(--weight-strong);
      font-variant-numeric: tabular-nums lining-nums;
    }

    .method-pipeline__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-2) var(--space-4);
      min-width: 0;
    }

    .method-pipeline h3 {
      font-size: var(--text-subsection);
      line-height: 1.2;
    }

    .method-pipeline__state {
      padding-block: 0.15rem;
      border-block-end: 1px solid var(--color-evidence-line);
      color: var(--color-evidence-text);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .method-pipeline p {
      max-width: var(--measure-wide);
      color: var(--color-text-secondary);
      font-size: var(--text-small);
      line-height: 1.55;
    }

    @container (min-width: 54rem) {
      .method-pipeline__step {
        grid-template-columns: 2.75rem minmax(11rem, 3fr) minmax(0, 6fr);
        align-items: start;
      }

      .method-pipeline__index {
        grid-row: auto;
      }

      .method-pipeline p {
        max-width: none;
      }
    }
  }
</style>
