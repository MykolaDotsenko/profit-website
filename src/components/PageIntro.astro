---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  /** Short status, e.g. "In development — not yet available". */
  status?: string;
}

const { eyebrow, title, lead, status } = Astro.props;
---

<header class="page-intro">
  <div class="container page-intro__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-intro__title">{title}</h1>
    <p class="lead page-intro__lead">{lead}</p>
    {status && <p class="status-chip">{status}</p>}
    <slot />
  </div>
</header>

<style>
  @layer layout {
    .page-intro {
      padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 1.8rem + 3vw, 4.5rem);
      border-block-end: 1px solid var(--color-line);
    }
    .page-intro__inner {
      display: grid;
      gap: var(--space-4);
      justify-items: start;
    }
    .page-intro__title {
      font-size: var(--text-page-title);
      max-width: 20ch;
    }
    .page-intro__lead {
      max-width: var(--measure-wide);
    }
  }
</style>
