---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  /** Short status, e.g. "In development — not yet available". */
  status?: string;
}

const { eyebrow, title, lead, status } = Astro.props;
---

<header class="page-intro">
  <div class="container">
    <div class="page-intro__frame">
      <div class="page-intro__rail">
        <p class="operational-label">PROFIT / {eyebrow}</p>
        {status && <p class="status-chip">{status}</p>}
      </div>
      <div class="page-intro__main">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="page-intro__title">{title}</h1>
        <p class="lead page-intro__lead">{lead}</p>
        <slot />
      </div>
    </div>
  </div>
</header>

<style>
  @layer layout {
    .page-intro {
      padding-block: var(--space-5) clamp(3rem, 2rem + 4vw, 6rem);
    }
    .page-intro__frame {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      min-width: 0;
      max-width: 100%;
      border: 1px solid var(--color-line-strong);
      background: var(--color-surface);
    }
    .page-intro__rail {
      display: flex;
      min-width: 0;
      max-width: 100%;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-5);
      border-block-end: 1px solid var(--color-line-strong);
      background: var(--color-production-rail);
    }
    .page-intro__main {
      display: grid;
      min-width: 0;
      max-width: 100%;
      gap: var(--space-4);
      justify-items: start;
      padding: clamp(1.5rem, 1rem + 3vw, 3.75rem);
    }
    .page-intro__rail > *,
    .page-intro__main > * {
      min-width: 0;
      max-width: 100%;
    }

    .operational-label {
      overflow-wrap: anywhere;
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
    .page-intro__title {
      font-size: var(--text-page-title);
      max-width: 20ch;
    }
    .page-intro__lead {
      max-width: var(--measure-wide);
    }
    @media (min-width: 62rem) {
      .page-intro__frame {
        grid-template-columns: minmax(12rem, 3fr) minmax(0, 9fr);
      }
      .page-intro__rail {
        align-content: space-between;
        align-items: start;
        border-block-end: 0;
        border-inline-end: 1px solid var(--color-line-strong);
      }
    }
  }
</style>
