---
/** The canonical evidence ladder, with where the current material sits. */
import { EVIDENCE_LADDER, type EvidenceState } from '../domain/evidence';
import { localeInfo, ui } from '../i18n';

interface Props {
  /** Marks the rung the site's own material sits on. */
  current: EvidenceState;
  currentLabel: string;
}

const { current, currentLabel } = Astro.props;
const t = ui(localeInfo(Astro.currentLocale).code);
---

<ol class="ladder" role="list">
  {
    EVIDENCE_LADDER.map((state, i) => (
      <li class:list={['ladder__rung', { 'is-current': state === current }]}>
        <p class="ladder__head">
          <span class="ladder__index num">{i + 1}</span>
          <span class="ladder__name">{t.evidence.states[state]}</span>
        </p>
        <p class="ladder__text">{t.evidence.stateDescriptions[state]}</p>
        {state === current && <p class="ladder__current">{currentLabel}</p>}
      </li>
    ))
  }
</ol>

<style>
  @layer components {
    .ladder {
      display: grid;
      border: 1px solid var(--color-line-strong);
    }
    .ladder__rung {
      display: grid;
      gap: var(--space-2);
      align-content: start;
      min-width: 0;
      padding: var(--space-4);
    }
    .ladder__rung + .ladder__rung {
      border-block-start: 1px solid var(--color-line);
    }
    .ladder__head {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
    }
    .ladder__index {
      font-family: var(--font-label);
      font-size: var(--text-caption);
      color: var(--color-text-secondary);
    }
    .ladder__name {
      font-size: var(--text-subsection);
      font-weight: var(--weight-strong);
    }
    .ladder__text {
      font-size: var(--text-small);
      color: var(--color-text-secondary);
    }
    .ladder__rung.is-current {
      border-inline-start: 0.3rem solid currentColor;
    }
    .ladder__current {
      justify-self: start;
      padding: 0.2rem 0.5rem;
      border: 1px solid currentColor;
      border-radius: var(--radius-s);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
    @container (min-width: 56rem) {
      .ladder {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }
      .ladder__rung + .ladder__rung {
        border-block-start: 0;
        border-inline-start: 1px solid var(--color-line);
      }
    }
  }
</style>
