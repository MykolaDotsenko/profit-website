---
/**
 * Structured company identity surface.
 *
 * Missing facts are shown only in review mode and may never be invented. Public release remains
 * blocked by src/config/release.ts until authoritative company details are supplied.
 */
import { site } from '../config/site';
import type { CompanyFact } from '../content/types';
import { localeInfo, ui } from '../i18n';

interface Props {
  items: readonly CompanyFact[];
}

const { items } = Astro.props;
const t = ui(localeInfo(Astro.currentLocale).code);
const visible = items.filter((item) => item.value || site.showContentStatus);
---

{
  visible.length > 0 && (
    <dl class="company-facts" data-company-proof-state={items.every((item) => item.value) ? 'complete' : 'pending'}>
      {
        visible.map((item) => (
          <div class="company-fact">
            <dt>{item.label}</dt>
            <dd>
              {
                item.value ? (
                  item.href ? <a class="text-link" href={item.href}>{item.value}</a> : item.value
                ) : (
                  <span class="company-fact__pending">{t.status.gapLabel}</span>
                )
              }
            </dd>
          </div>
        ))
      }
    </dl>
  )
}

<style>
  @layer components {
    .company-facts {
      display: grid;
      border-block: 1px solid var(--color-line-strong);
    }
    .company-fact {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-4);
    }
    .company-fact + .company-fact {
      border-block-start: 1px solid var(--color-line);
    }
    .company-fact dt {
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
    .company-fact dd {
      margin: 0;
      font-weight: var(--weight-strong);
    }
    .company-fact__pending {
      color: var(--color-text-secondary);
      font-size: var(--text-small);
      font-weight: var(--weight-regular);
    }
    @container (min-width: 42rem) {
      .company-fact {
        grid-template-columns: minmax(10rem, 3fr) minmax(0, 6fr);
        align-items: baseline;
      }
    }
  }
</style>
