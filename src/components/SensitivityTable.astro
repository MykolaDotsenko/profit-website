---
import type { SensitivityScenario } from '../content/examples/field-sensitivity';
import { present } from '../domain/format';
import type { CurrencyCode } from '../domain/economics';
import { localeInfo, ui } from '../i18n';

interface Props {
  scenarios: readonly SensitivityScenario[];
  currency: CurrencyCode;
  labels: {
    caption: string;
    scenario: string;
    yield: string;
    price: string;
    costs: string;
    profit: string;
    names: Record<SensitivityScenario['id'], string>;
  };
}

const { scenarios, currency, labels } = Astro.props;
const locale = localeInfo(Astro.currentLocale);
const t = ui(locale.code);
const money = (amount: number) =>
  present({ metric: 'operating_profit', amount, currency, perArea: 'ha' }, locale.intl, t.units);
const price = (amount: number) =>
  present({ metric: 'price', amount, currency, perMass: 't' }, locale.intl, t.units);
const yieldValue = (amount: number) =>
  present({ metric: 'yield', amount, mass: 't', perArea: 'ha' }, locale.intl, t.units);
---

<div class="sensitivity-table-wrap">
  <table class="sensitivity-table">
    <caption>{labels.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{labels.scenario}</th>
        <th scope="col">{labels.yield}</th>
        <th scope="col">{labels.price}</th>
        <th scope="col">{labels.costs}</th>
        <th scope="col">{labels.profit}</th>
      </tr>
    </thead>
    <tbody>
      {scenarios.map((s) => (
        <tr class:list={{ 'is-base': s.id === 'base' }}>
          <th scope="row">
            <span class="scenario-name">{labels.names[s.id]}</span>
            <span class="scenario-note">{s.note}</span>
          </th>
          <td>{yieldValue(s.yieldPerHa).figure} <span class="unit">{yieldValue(s.yieldPerHa).unit}</span></td>
          <td>{price(s.pricePerT).figure}<span class="unit">{price(s.pricePerT).unit}</span></td>
          <td>{money(s.operatingCostsPerHa).figure}<span class="unit">{money(s.operatingCostsPerHa).unit}</span></td>
          <td class:list={['profit', { negative: s.operatingProfitPerHa < 0 }]}>
            {money(s.operatingProfitPerHa).figure}<span class="unit">{money(s.operatingProfitPerHa).unit}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .sensitivity-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .sensitivity-table {
    width: 100%;
    min-width: 48rem;
    border-collapse: collapse;
  }
  caption {
    caption-side: top;
    text-align: start;
    padding: var(--space-4);
    font-size: var(--text-small);
    font-weight: var(--weight-strong);
  }
  th, td {
    padding: var(--space-3) var(--space-4);
    border-block-start: 1px solid var(--color-line);
    text-align: end;
    vertical-align: top;
    font-variant-numeric: tabular-nums lining-nums;
  }
  th:first-child {
    text-align: start;
  }
  thead th {
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
  }
  tbody th {
    font-weight: var(--weight-regular);
  }
  .scenario-name {
    display: block;
    font-weight: var(--weight-strong);
  }
  .scenario-note {
    display: block;
    margin-block-start: var(--space-1);
    max-width: 34rem;
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.4;
  }
  .unit {
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
  }
  .profit {
    font-weight: var(--weight-strong);
  }
  tr.is-base {
    background: var(--color-evidence-bg);
  }
</style>
