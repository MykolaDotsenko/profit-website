---
import TeamPortrait from './TeamPortrait.astro';
import type { SectionIntro, TeamMember } from '../content/types';

interface Props {
  intro: SectionIntro;
  flow: readonly string[];
  members: readonly TeamMember[];
  labels: {
    flowAria: string;
    expertise: string;
    contribution: string;
    profiles: string;
    portraitRequirement: string;
  };
  compact?: boolean;
}

const { intro, flow, members, labels, compact = false } = Astro.props;
---

<div class:list={['team-capability', { 'team-capability--compact': compact }]}>
  <header class="team-capability__head">
    {intro.eyebrow && <p class="eyebrow">{intro.eyebrow}</p>}
    <h3 class="team-capability__title">{intro.title}</h3>
    {intro.lead && <p class="team-capability__lead">{intro.lead}</p>}
  </header>

  <ol class="team-capability__flow" aria-label={labels.flowAria} role="list">
    {flow.map((step, index) => (
      <li>
        <span class="team-capability__flow-index num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span>{step}</span>
      </li>
    ))}
  </ol>

  <div class="team-capability__members" role="list">
    {members.map((member, index) => (
      <article class="team-member" role="listitem">
        <div class="team-member__index num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
        <div class="team-member__identity">
          {!compact && <TeamPortrait name={member.name} image={member.portrait} requirement={labels.portraitRequirement} />}
          <div class="team-member__identity-copy">
            <h4>{member.name}</h4>
            <p>{member.role}</p>
          </div>
        </div>
        <div class="team-member__strength">
          <span>{labels.expertise}</span>
          <p>{member.strength}</p>
        </div>
        {!compact && (
          <div class="team-member__contribution">
            <span>{labels.contribution}</span>
            <p>{member.contribution}</p>
          </div>
        )}
        {!compact && member.links.length > 0 && (
          <div class="team-member__proof">
            <span class="team-member__proof-label">{labels.profiles}</span>
            <ul class="team-member__links" role="list" aria-label={`${member.name} — ${labels.profiles}`}>
              {member.links.map((link) => (
                <li><a class="text-link" href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        )}
      </article>
    ))}
  </div>
</div>

<style>
  @layer components {
    .team-capability {
      display: grid;
      gap: var(--space-5);
      border: 1px solid var(--color-line-strong);
      background: var(--color-surface);
    }

    .team-capability__head {
      display: grid;
      gap: var(--space-3);
      padding: var(--space-5);
      background: var(--color-production-rail);
      border-block-end: 1px solid var(--color-line-strong);
    }

    .team-capability__title {
      max-width: 24ch;
      font-size: var(--text-subsection);
      line-height: 1.2;
    }

    .team-capability__lead {
      max-width: var(--measure-wide);
      color: var(--color-text-secondary);
      line-height: 1.55;
    }

    .team-capability__flow {
      display: grid;
      margin-inline: var(--space-5);
      border-block: 1px solid var(--color-line);
    }

    .team-capability__flow li {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-3);
      align-items: baseline;
      padding-block: var(--space-3);
      border-block-end: 1px solid var(--color-line);
      font-family: var(--font-label);
      font-size: var(--text-small);
      font-weight: var(--weight-strong);
    }

    .team-capability__flow li:last-child {
      border-block-end: 0;
    }

    .team-capability__flow-index,
    .team-member__index {
      color: var(--color-text-secondary);
      font-size: var(--text-label);
    }

    .team-capability__members {
      display: grid;
    }

    .team-member {
      display: grid;
      gap: var(--space-4);
      padding: var(--space-5);
      border-block-start: 1px solid var(--color-line-strong);
    }

    .team-member__identity {
      display: grid;
      gap: var(--space-3);
      align-content: start;
    }

    .team-member__identity-copy {
      display: grid;
      gap: var(--space-1);
    }

    .team-member__identity h4 {
      font-size: var(--text-body);
      line-height: 1.25;
    }

    .team-member__identity p,
    .team-member__strength p,
    .team-member__contribution p {
      line-height: 1.5;
    }

    .team-member__identity p {
      color: var(--color-text-secondary);
      font-size: var(--text-small);
      font-weight: var(--weight-strong);
    }

    .team-member__strength,
    .team-member__contribution {
      display: grid;
      gap: var(--space-1);
    }

    .team-member__strength > span,
    .team-member__contribution > span {
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .team-member__strength p,
    .team-member__contribution p {
      font-size: var(--text-small);
    }

    .team-member__proof {
      display: grid;
      gap: var(--space-2);
    }

    .team-member__proof-label {
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .team-member__links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-5);
      align-items: baseline;
      font-size: var(--text-small);
    }

    @container (min-width: 46rem) {
      .team-capability__flow {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .team-capability__flow li {
        align-content: start;
        border-block-end: 0;
        border-inline-end: 1px solid var(--color-line);
        padding-inline: var(--space-3);
      }

      .team-capability__flow li:first-child {
        padding-inline-start: 0;
      }

      .team-capability__flow li:last-child {
        border-inline-end: 0;
        padding-inline-end: 0;
      }

      .team-member {
        grid-template-columns: 2.25rem minmax(11rem, 2.1fr) minmax(12rem, 2.4fr) minmax(0, 4fr);
        align-items: start;
      }

      .team-member__proof {
        grid-column: 4;
      }

      .team-capability--compact .team-member {
        grid-template-columns: 2.25rem minmax(11rem, 2fr) minmax(0, 4fr);
      }
    }
  }
</style>
