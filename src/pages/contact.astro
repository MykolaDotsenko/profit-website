---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentGap from '../components/ContentGap.astro';
import PageIntro from '../components/PageIntro.astro';
import PilotForm from '../components/PilotForm.astro';
import { site } from '../config/site';
import { content } from '../content';

const p = content(Astro.currentLocale).contact;
---

<BaseLayout title={p.meta.title} description={p.meta.description}>
  <PageIntro eyebrow={p.intro.eyebrow} title={p.intro.title} lead={p.intro.lead} />

  <div class="container contact">
    <div class="contact__next">
      <h2 class="contact__title">{p.stepsTitle}</h2>
      <ol class="contact__steps" role="list">
        {
          p.steps.map((step, i) => (
            <li>
              <span class="contact__index num" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <p class="contact__step-title">{step.title}</p>
                <p class="contact__step-text">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <ContentGap owner={p.review.owner} kind="review" text={p.review.text} />

      <section class="contact__other" id="other" aria-labelledby="other-title">
        <h2 id="other-title" class="contact__title">{p.other.title}</h2>
        <p>{p.other.text}</p>
        <ContentGap owner={p.other.gap.owner} text={p.other.gap.text} />
      </section>
    </div>

    <PilotForm content={p.form} endpoint={site.pilotFormEndpoint} />
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-section);
  }
  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .contact__next {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .contact__title {
    font-size: var(--text-subsection);
  }
  .contact__steps {
    border-block-start: 1px solid var(--color-line-strong);
  }
  .contact__steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-line);
  }
  .contact__index {
    font-weight: var(--weight-strong);
    font-size: var(--text-lead);
    line-height: 1.3;
  }
  .contact__step-title {
    font-weight: var(--weight-strong);
  }
  .contact__step-text {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  .contact__other {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-6);
  }
</style>
