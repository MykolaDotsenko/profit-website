---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import ItemList from '../components/ItemList.astro';
import MethodPipeline from '../components/MethodPipeline.astro';
import OnPageNav from '../components/OnPageNav.astro';
import PageIntro from '../components/PageIntro.astro';
import ProductionScope from '../components/ProductionScope.astro';
import QuestionList from '../components/QuestionList.astro';
import Section from '../components/Section.astro';
import { content } from '../content';
import { localeInfo, ui } from '../i18n';

const c = content(Astro.currentLocale);
const p = c.farmers;
const t = ui(localeInfo(Astro.currentLocale).code);
---

<BaseLayout title={p.meta.title} description={p.meta.description}>
  <PageIntro eyebrow={p.intro.eyebrow} title={p.intro.title} lead={p.intro.lead}>
    <OnPageNav
      label={p.onPageLabel}
      items={[p.scope.intro, p.dataCollection.intro, p.dataPath.intro, p.provide.intro, p.getBack.intro, p.notDo.intro, p.questions.intro, { id: 'pilot', title: t.common.pilot }]}
    />
  </PageIntro>

  <Section intro={p.scope.intro} tone="sunken">
    <ProductionScope items={p.scope.units} />
    <p class="scope-note">{p.scope.note}</p>
  </Section>

  <Section intro={p.dataCollection.intro}>
    <ItemList items={p.dataCollection.items} columns={2} layout="rows" />
    <p class="method-note">{p.dataCollection.note}</p>
  </Section>

  <Section intro={p.dataPath.intro} tone="sunken">
    <MethodPipeline steps={p.dataPath.steps} ariaLabel={t.common.dataQualityPath} />
  </Section>

  <Section intro={p.provide.intro} layout="split">
    <ItemList items={p.provide.items} columns={2} />
  </Section>

  <Section intro={p.getBack.intro} layout="split" tone="sunken">
    <ItemList items={p.getBack.items} columns={2} />
  </Section>

  <Section intro={p.notDo.intro} layout="split">
    <ItemList items={p.notDo.items} columns={2} marker="cross" layout="rows" />
    <p class="ai-note">{p.notDo.ai}</p>
  </Section>

  <Section intro={p.questions.intro} layout="split">
    <QuestionList questions={c.shared.hardQuestions} />
  </Section>

  <CtaBand
    intro={{ ...p.pilot.intro, id: 'pilot', title: t.common.howPilotWouldWork }}
    stepsTitle={p.pilot.stepsTitle}
    steps={p.pilot.steps}
    primary={p.pilot.primary}
  />
</BaseLayout>

<style>
  .scope-note {
    margin-block-start: var(--space-6);
    max-width: var(--measure-wide);
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-line-strong);
    font-size: var(--text-small);
    font-weight: var(--weight-strong);
  }
  .ai-note,
  .method-note {
    margin-block-start: var(--space-5);
    max-width: var(--measure-wide);
    font-weight: var(--weight-strong);
  }
  .method-note {
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-line-strong);
    font-size: var(--text-small);
  }
</style>
