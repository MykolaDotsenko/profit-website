---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConfidenceScale from '../components/ConfidenceScale.astro';
import ContentGap from '../components/ContentGap.astro';
import CtaBand from '../components/CtaBand.astro';
import DecisionChange from '../components/DecisionChange.astro';
import EvidenceLadder from '../components/EvidenceLadder.astro';
import FieldExample from '../components/FieldExample.astro';
import Hero from '../components/Hero.astro';
import ItemList from '../components/ItemList.astro';
import JourneyNav from '../components/JourneyNav.astro';
import ProductionScope from '../components/ProductionScope.astro';
import QuestionList from '../components/QuestionList.astro';
import Section from '../components/Section.astro';
import StepSequence from '../components/StepSequence.astro';
import TeamCapabilities from '../components/TeamCapabilities.astro';
import VerificationChain from '../components/VerificationChain.astro';
import { site } from '../config/site';
import { content } from '../content';
import { fieldSeasonExample } from '../content/examples/field-season';
import { localePath } from '../i18n';

const c = content(Astro.currentLocale);
const h = c.home;
const s = c.shared;
const variant = s.heroVariants[site.heroVariant];
const link = (href: string) => localePath(Astro.currentLocale, href);
---

<BaseLayout description={h.meta.description}>
  <!-- 1 · Hero: copy is a WWW-000 hypothesis record (content/en/shared.ts), not a tested winner. -->
  <Hero
    variant={variant}
    primary={h.hero.primary}
    secondary={h.hero.secondary}
    example={fieldSeasonExample}
    proofLabels={h.hero.proofLabels}
    image={h.hero.image}
  >
    <section slot="summary" class="tldr" aria-labelledby="tldr-title">
      <h2 id="tldr-title" class="eyebrow tldr__title">{h.thirtySeconds.title}</h2>
      <dl class="tldr__list">
        {
          h.thirtySeconds.items.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </Hero>

  <JourneyNav label={h.journey.label} items={h.journey.items} />

  <!-- 2 · Farmer problem -->
  <Section intro={h.problem.intro} spacing="standard">
    <ol class="farmer-questions" role="list">
      {
        h.problem.questions.map((q, i) => (
          <li class:list={['farmer-question', { 'is-farmer-call': !q.covered }]}>
            <span class="farmer-question__index num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="farmer-question__text">{q.question}</h3>
            <p class="farmer-question__answer">{q.answer}</p>
          </li>
        ))
      }
    </ol>

    <div class="record-intake">
      <div class="record-intake__head">
        <p class="eyebrow">Records behind the decision</p>
        <h3>{h.problem.hard.title}</h3>
        <p>{h.problem.hard.lead}</p>
      </div>
      <ol class="record-intake__sources" role="list">
        {
          h.problem.hard.sources.map((src, i) => (
            <li>
              <span class="record-intake__index num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="record-intake__name">{src.title}</span>
              <span class="record-intake__detail">{src.text}</span>
            </li>
          ))
        }
      </ol>
      <p class="record-intake__conclusion">{h.problem.hard.conclusion}</p>
    </div>

    <DecisionChange
      title={h.problem.changeFrame.title}
      leftLabel={h.problem.changeFrame.leftLabel}
      rightLabel={h.problem.changeFrame.rightLabel}
      rows={h.problem.changeFrame.rows}
      note={h.problem.changeFrame.note}
    />
  </Section>

  <!-- 3 · How PROFIT works -->
  <Section intro={h.how.intro} spacing="compact">
    <StepSequence steps={h.how.steps} actors={s.actors} moduleLabel={h.how.moduleLabel} />
    <p class="how-note">{h.how.note}</p>

    <div class="how-cluster">
      <h3 class="how-cluster__title">{h.how.operatingPrinciplesTitle}</h3>
      <ItemList items={h.how.operatingPrinciples} columns={2} />
      <p class="how-cluster__note">{h.how.operatingPrinciplesNote}</p>
      <p class="source-note">
        <a class="text-link" href={link(h.how.operatingPrinciplesLink.href)}>{h.how.operatingPrinciplesLink.label}</a>
      </p>
    </div>
  </Section>

  <!-- 4 · Product / economic proof -->
  <Section intro={h.example.intro} spacing="spacious">
    <FieldExample example={fieldSeasonExample} labels={h.example.labels} />
  </Section>

  <!-- 5 · Field Profitability, the first wedge -->
  <Section intro={h.wedge.intro} layout="split" spacing="compact">
    <p slot="head" class="status-chip">{h.wedge.status}</p>
    <div class="wedge">
      <div>
        <h3 class="wedge__title">{h.wedge.inputsTitle}</h3>
        <ul class="wedge__list" role="list">{s.fieldProfitability.inputs.map((i) => <li>{i.title}</li>)}</ul>
      </div>
      <div>
        <h3 class="wedge__title">{h.wedge.outputsTitle}</h3>
        <ul class="wedge__list" role="list">{s.fieldProfitability.outputs.map((i) => <li>{i.title}</li>)}</ul>
      </div>
      <div>
        <h3 class="wedge__title">{h.wedge.exclusionsTitle}</h3>
        <ul class="wedge__list wedge__list--excluded" role="list">
          {s.fieldProfitability.exclusions.map((i) => <li>{i.title}</li>)}
        </ul>
      </div>
    </div>
    <p class="wedge__ai">{s.fieldProfitability.ai}</p>
    <p><a class="text-link" href={link(h.wedge.link.href)}>{h.wedge.link.label}</a></p>
  </Section>

  <!-- 6 · Master-brand production scope: direction, not a claim of shipped modules. -->
  <Section intro={h.scope.intro} tone="sunken" spacing="compact">
    <ProductionScope items={h.scope.units} />
    <aside class="scope-proof" aria-label="EU agriculture context">
      <p class="scope-proof__value num">{h.scope.contextStat.value}</p>
      <p class="scope-proof__label">{h.scope.contextStat.label}</p>
      <p class="scope-proof__note">{h.scope.contextStat.detail}</p>
      <p class="source-note">
        <a class="text-link" href={h.scope.source.href}>{h.scope.source.label}</a>
      </p>
    </aside>
    <p class="scope-note">{h.scope.note}</p>
  </Section>

  <!-- 7 · Economic value / evidence logic -->
  <Section intro={h.value.intro} tone="inverse" spacing="spacious">
    <div class="value">
      <div>
        <h3 class="value__title">{h.value.ladderTitle}</h3>
        <EvidenceLadder current={fieldSeasonExample.meta.evidence} currentLabel={h.value.currentLabel} />
      </div>
      <div class="value__split">
        <div>
          <h3 class="value__title">{h.value.confidenceTitle}</h3>
          <p class="value__text">{h.value.confidenceText}</p>
          <ConfidenceScale assessedLabel={h.value.assessedLabel} notAssessedText={h.value.notAssessedText} />
        </div>
        <div class="value__status">
          <p class="value__status-label">{h.value.currentSiteLabel}</p>
          <p class="value__status-text">{h.value.currentSiteNote}</p>
          <details class="value__disclosure">
            <summary>
              <span>{h.value.chainSummary}</span>
              <span class="value__disclosure-icon" aria-hidden="true">+</span>
            </summary>
            <div class="value__disclosure-body">
              <h3 class="value__title">{h.value.chainTitle}</h3>
              <VerificationChain steps={s.verificationChain} />
              <p class="value__note">{h.value.chainNote}</p>
            </div>
          </details>
        </div>
      </div>
      <p><a class="text-link" href={link(h.value.link.href)}>{h.value.link.label}</a></p>
    </div>
  </Section>

  <!-- 8 · Trust / farmer control -->
  <Section intro={h.control.intro} tone="sunken" spacing="standard">
    <ItemList items={h.control.principles} columns={2} marker="number" />
    <div class="control-questions">
      <h3 class="control-questions__title">{h.control.questionsTitle}</h3>
      <QuestionList questions={s.questions(h.control.questionIds)} level={4} />
      <ul class="control-links" role="list">
        {
          h.control.links.map((l) => (
            <li>
              <a class="text-link" href={link(l.href)}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- 9 · Company -->
  <Section intro={h.company.intro} layout="split" spacing="compact">
    <div class="company stack">
      {h.company.text.map((p) => <p class="company__text">{p}</p>)}
      <h3 class="company__subtitle">{h.company.stillProvenTitle}</h3>
      <ul class="company__list">{h.company.stillProven.map((p) => <li>{p}</li>)}</ul>
      <TeamCapabilities intro={s.teamCapability.intro} flow={s.teamCapability.flow} members={s.teamCapability.members} labels={s.teamCapability.labels} compact />
      <ContentGap kind="review" owner={h.company.teamGap.owner} text={h.company.teamGap.text} />
      <p><a class="text-link" href={link(h.company.link.href)}>{h.company.link.label}</a></p>
    </div>
  </Section>

  <!-- 10 · Pilot CTA (footer follows in the layout) -->
  <CtaBand
    intro={h.cta.intro}
    stepsTitle={h.cta.stepsTitle}
    steps={h.cta.steps}
    review={h.cta.review}
    primary={h.cta.primary}
    secondary={h.cta.secondary}
  />
</BaseLayout>

<style>
  @layer components {
    .tldr {
      container-type: inline-size;
      display: grid;
      gap: var(--space-3);
      padding-block-start: var(--space-4);
      border-block-start: 1px solid var(--color-line-strong);
    }
    .tldr__title {
      color: var(--color-text);
    }
    .tldr__list > div {
      display: grid;
      align-content: start;
      gap: 0.125rem;
      padding-block: var(--space-3);
      border-block-start: 1px solid var(--color-line);
    }
    .tldr__list dt {
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-secondary);
    }
    .tldr__list dd {
      font-size: var(--text-small);
      line-height: 1.5;
    }
    @container (min-width: 32rem) {
      .tldr__list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: var(--space-6);
      }
    }

    .scope-proof {
      display: grid;
      gap: var(--space-2);
      margin-block-start: var(--space-6);
      padding: var(--space-4) var(--space-5);
      border: 1px solid var(--color-line);
      background: var(--color-surface);
    }
    .how-cluster__title {
      font-size: var(--text-subsection);
      margin-block-end: var(--space-4);
    }
    .scope-proof__value {
      font-size: clamp(1.75rem, 3vw, 2.75rem);
      line-height: 1;
      letter-spacing: -0.035em;
      font-weight: var(--weight-strong);
    }
    .scope-proof__label {
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
    @container (min-width: 44rem) {
      .scope-proof {
        grid-template-columns: auto minmax(12rem, 3fr) minmax(0, 6fr);
        align-items: baseline;
        column-gap: var(--space-5);
      }
      .scope-proof__note {
        margin-block-start: 0;
      }
      .scope-proof .source-note {
        grid-column: 3;
      }
    }
    .scope-proof__note,
    .scope-note,
    .how-cluster__note,
    .source-note {
      max-width: var(--measure-wide);
      color: var(--color-text-secondary);
      font-size: var(--text-small);
    }
    .scope-proof__note,
    .how-cluster__note {
      margin-block-start: var(--space-4);
    }
    .scope-note {
      margin-block-start: var(--space-6);
      padding-inline-start: var(--space-4);
      border-inline-start: 3px solid var(--color-line-strong);
      color: var(--color-text);
      font-weight: var(--weight-strong);
    }
    .source-note {
      margin-block-start: var(--space-2);
    }
    .how-cluster {
      display: grid;
      gap: var(--space-8);
      margin-block-start: var(--space-8);
      padding-block-start: var(--space-6);
      border-block-start: 1px solid var(--color-line-strong);
    }
    .farmer-questions {
      border-block-start: 1px solid var(--color-line-strong);
    }
    .farmer-question {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: var(--space-1) var(--space-3);
      padding-block: var(--space-5);
      border-block-end: 1px solid var(--color-line);
    }
    .farmer-question__index {
      grid-row: span 2;
      font-size: var(--text-small);
      font-weight: var(--weight-strong);
      color: var(--color-text-secondary);
      padding-block-start: 0.45em;
    }
    .farmer-question__text {
      font-size: var(--text-question);
      line-height: 1.2;
      letter-spacing: -0.01em;
      max-width: 30ch;
    }
    .farmer-question__answer {
      font-size: var(--text-small);
      color: var(--color-text-secondary);
    }
    .farmer-question.is-farmer-call .farmer-question__answer {
      color: var(--color-text);
      font-weight: var(--weight-strong);
    }
    @container (min-width: 56rem) {
      .farmer-question {
        grid-template-columns: 3rem minmax(0, 7fr) minmax(0, 4fr);
        align-items: baseline;
      }
      .farmer-question__index {
        grid-row: auto;
      }
    }

    .record-intake {
      margin-block-start: var(--space-8);
      display: grid;
      gap: 1px;
      border: 1px solid var(--color-line-strong);
      background: var(--color-line-strong);
    }
    .record-intake__head,
    .record-intake__conclusion {
      background: var(--color-production-rail);
      padding: var(--space-5);
    }
    .record-intake__head {
      display: grid;
      gap: var(--space-2);
    }
    .record-intake__head h3 {
      font-size: var(--text-subsection);
    }
    .record-intake__head p:not(.eyebrow),
    .record-intake__conclusion {
      max-width: var(--measure-wide);
      color: var(--color-text-secondary);
      line-height: 1.55;
    }
    .record-intake__sources {
      display: grid;
      gap: 1px;
      background: var(--color-line);
    }
    .record-intake__sources li {
      display: grid;
      grid-template-columns: 2.5rem minmax(8rem, 3fr) minmax(0, 6fr);
      gap: var(--space-3);
      align-items: baseline;
      padding: var(--space-4) var(--space-5);
      background: var(--color-surface);
    }
    .record-intake__index {
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-caption);
    }
    .record-intake__name {
      font-weight: var(--weight-strong);
    }
    .record-intake__detail {
      color: var(--color-text-secondary);
      font-size: var(--text-small);
      line-height: 1.5;
    }
    @container (max-width: 34rem) {
      .record-intake__sources li {
        grid-template-columns: 2.25rem minmax(0, 1fr);
      }
      .record-intake__detail {
        grid-column: 2;
      }
    }

    .how-note {
      margin-block-start: var(--space-6);
      max-width: var(--measure-wide);
      padding-block-start: var(--space-4);
      border-block-start: 1px solid var(--color-line);
      color: var(--color-text-secondary);
      font-size: var(--text-small);
    }

    .value {
      display: grid;
      gap: var(--space-8);
    }
    .value__title {
      font-size: var(--text-subsection);
      margin-block-end: var(--space-4);
    }
    .value__text {
      max-width: var(--measure);
      color: var(--color-text-secondary);
      margin-block-end: var(--space-5);
    }
    .value__split {
      display: grid;
      gap: var(--space-7);
    }
    @container (min-width: 56rem) {
      .value__split {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-8);
      }
    }
    .value__status {
      display: grid;
      align-content: start;
      gap: var(--space-3);
    }
    .value__status-label {
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-inverse-secondary);
    }
    .value__status-text {
      max-width: 32ch;
      font-size: var(--text-subsection);
      line-height: 1.25;
      font-weight: var(--weight-strong);
    }
    .value__disclosure {
      margin-block-start: var(--space-3);
      border-block: 1px solid var(--color-inverse-line);
    }
    .value__disclosure summary {
      display: flex;
      justify-content: space-between;
      gap: var(--space-4);
      align-items: center;
      padding-block: var(--space-4);
      cursor: pointer;
      list-style: none;
      font-weight: var(--weight-strong);
    }
    .value__disclosure summary::-webkit-details-marker {
      display: none;
    }
    .value__disclosure summary:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 4px;
    }
    .value__disclosure-icon {
      display: inline-grid;
      place-items: center;
      width: 1.5rem;
      height: 1.5rem;
      border: 1px solid currentColor;
      border-radius: 50%;
      line-height: 1;
      transition: transform 160ms ease;
    }
    .value__disclosure[open] .value__disclosure-icon {
      transform: rotate(45deg);
    }
    .value__disclosure-body {
      padding-block: var(--space-2) var(--space-5);
    }
    .value__note {
      margin-block-start: var(--space-4);
      font-weight: var(--weight-strong);
    }
    @media (prefers-reduced-motion: reduce) {
      .value__disclosure-icon {
        transition: none;
      }
    }

    .wedge {
      display: grid;
      gap: 1px;
      border: 1px solid var(--color-line-strong);
      background: var(--color-line-strong);
    }
    .wedge > div {
      min-width: 0;
      padding: var(--space-4);
      background: var(--color-surface);
    }
    .wedge > div:last-child {
      background: var(--color-surface-sunken);
    }
    @container (min-width: 48rem) {
      .wedge {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    .wedge__title {
      margin: calc(var(--space-4) * -1) calc(var(--space-4) * -1) var(--space-3);
      padding: var(--space-3) var(--space-4);
      border-block-end: 1px solid var(--color-line);
      background: var(--color-production-rail);
      color: var(--color-text-secondary);
      font-family: var(--font-label);
      font-size: var(--text-label);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
    .wedge > div:last-child .wedge__title {
      background: var(--color-surface-sunken);
    }
    .wedge__list li {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-2);
      align-items: baseline;
      padding-block: var(--space-2);
      border-block-end: 1px solid var(--color-line);
      font-size: var(--text-small);
      line-height: 1.45;
    }
    .wedge__list li::before {
      content: '→';
      color: var(--color-production);
      font-family: var(--font-label);
    }
    .wedge__list--excluded li {
      color: var(--color-text-secondary);
    }
    .wedge__list--excluded li::before {
      content: '×';
      color: currentColor;
    }
    .wedge__ai {
      margin-block: var(--space-6) var(--space-4);
      max-width: var(--measure-wide);
      font-weight: var(--weight-strong);
    }

    .control-questions {
      margin-block-start: var(--space-8);
      display: grid;
      gap: var(--space-4);
      max-width: 52rem;
    }
    .control-questions__title {
      font-size: var(--text-subsection);
    }
    .control-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-6);
    }

    .company {
      max-width: var(--measure-wide);
      --stack-space: var(--space-4);
    }
    .company__text {
      font-size: var(--text-lead);
      line-height: 1.5;
    }
    .company__subtitle {
      font-size: var(--text-label);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-secondary);
      padding-block-start: var(--space-4);
    }
    .company__list {
      padding-inline-start: 1.25rem;
    }
    .company__list li + li {
      margin-block-start: var(--space-2);
    }
  }
</style>
