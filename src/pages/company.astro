---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentGap from '../components/ContentGap.astro';
import CtaBand from '../components/CtaBand.astro';
import ItemList from '../components/ItemList.astro';
import MethodPipeline from '../components/MethodPipeline.astro';
import ModelComparisonTable from '../components/ModelComparisonTable.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import { content } from '../content';

const p = content(Astro.currentLocale).company;
---

<BaseLayout title={p.meta.title} description={p.meta.description}>
  <PageIntro eyebrow={p.intro.eyebrow} title={p.intro.title} lead={p.intro.lead}>
    <nav class="on-page" aria-label={p.onPageLabel}>
      <ul role="list">
        {[p.building.intro, p.scope.intro, p.dataStrategy.intro, p.forecasting.intro, p.decisionSupport.intro, p.stillProven.intro].map((s) => (
          <li><a href={`#${s.id}`}>{s.title}</a></li>
        ))}
      </ul>
    </nav>
  </PageIntro>

  <Section intro={p.building.intro} layout="split">
    <div class="prose">{p.building.text.map((para) => <p>{para}</p>)}</div>
  </Section>

  <Section intro={p.scope.intro} tone="sunken">
    <ItemList items={p.scope.systems} columns={3} />
    <p class="evidence-note">{p.scope.evidence}</p>
    <p class="source-note"><a class="text-link" href={p.scope.source.href}>{p.scope.source.label}</a></p>
    <p class="scope-note">{p.scope.note}</p>
  </Section>

  <Section intro={p.dataStrategy.intro} layout="split">
    <ItemList items={p.dataStrategy.items} columns={2} />
    <p class="evidence-note">{p.dataStrategy.evidence}</p>
    <ul class="source-list" role="list">
      {p.dataStrategy.sources.map((source) => (
        <li><a class="text-link" href={source.href}>{source.label}</a></li>
      ))}
    </ul>
  </Section>

  <Section intro={p.dataProcessing.intro} tone="sunken">
    <MethodPipeline steps={p.dataProcessing.steps} ariaLabel="PROFIT data quality gates" />
    <p class="scope-note">{p.dataProcessing.principle}</p>
  </Section>

  <Section intro={p.forecasting.intro} layout="split">
    <ItemList items={p.forecasting.items} columns={2} />
    <p class="evidence-note">{p.forecasting.research}</p>
    <ul class="source-list" role="list">
      {p.forecasting.sources.map((source) => (
        <li><a class="text-link" href={source.href}>{source.label}</a></li>
      ))}
    </ul>
    <p class="scope-note">{p.forecasting.note}</p>
  </Section>

  <Section intro={p.modelComparison.intro} tone="sunken">
    <ModelComparisonTable rows={p.modelComparison.rows} labels={p.modelComparison.labels} />
  </Section>

  <Section intro={p.decisionSupport.intro}>
    <MethodPipeline steps={p.decisionSupport.steps} ariaLabel="PROFIT decision-support architecture" />
    <p class="evidence-note">{p.decisionSupport.research}</p>
    <ul class="source-list" role="list">
      {p.decisionSupport.sources.map((source) => (
        <li><a class="text-link" href={source.href}>{source.label}</a></li>
      ))}
    </ul>
    <p class="scope-note">{p.decisionSupport.note}</p>
  </Section>

  <Section intro={p.why.intro} layout="split">
    <div class="prose">{p.why.text.map((para) => <p>{para}</p>)}</div>
  </Section>

  <Section intro={p.principles.intro} layout="split" tone="sunken">
    <ItemList items={p.principles.items} columns={1} marker="number" />
  </Section>

  <Section intro={p.stillProven.intro} layout="split">
    <ItemList items={p.stillProven.items} columns={1} />
  </Section>

  <Section intro={p.team.intro} layout="split">
    <ContentGap owner={p.team.gap.owner} text={p.team.gap.text} />
  </Section>

  <Section intro={p.details.intro} layout="split">
    <ContentGap owner={p.details.gap.owner} text={p.details.gap.text} />
  </Section>

  <CtaBand intro={p.cta.intro} stepsTitle={p.cta.stepsTitle} steps={p.cta.steps} review={p.cta.review} primary={p.cta.primary} />
</BaseLayout>

<style>
  .on-page ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-3);
    font-size: var(--text-small);
  }
  .evidence-note,
  .source-note,
  .source-list,
  .scope-note {
    max-width: var(--measure-wide);
    font-size: var(--text-small);
  }
  .evidence-note {
    margin-block-start: var(--space-5);
    color: var(--color-text-secondary);
  }
  .source-note,
  .source-list {
    margin-block-start: var(--space-2);
    color: var(--color-text-secondary);
  }
  .source-list {
    display: grid;
    gap: var(--space-1);
  }
  .scope-note {
    margin-block-start: var(--space-5);
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-line-strong);
    font-weight: var(--weight-strong);
  }
  .prose {
    max-width: var(--measure-wide);
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-lead);
    line-height: 1.55;
  }
</style>
