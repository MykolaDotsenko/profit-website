---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FieldExample from '../components/FieldExample.astro';
import ItemList from '../components/ItemList.astro';
import OnPageNav from '../components/OnPageNav.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import { content } from '../content';
import { fieldSeasonExample } from '../content/examples/field-season';

const c = content(Astro.currentLocale);
const p = c.product;
---

<BaseLayout title={p.meta.title} description={p.meta.description}>
  <PageIntro eyebrow={p.intro.eyebrow} title={p.intro.title} lead={p.intro.lead} status={p.intro.status}>
    <OnPageNav
      label={p.onPageLabel}
      items={[p.example.intro, p.definitions.intro, p.inputs.intro, p.calculation.intro, p.methodBoundary.intro, p.exclusions.intro]}
    />
  </PageIntro>

  <Section intro={p.example.intro} tone="sunken">
    <FieldExample example={fieldSeasonExample} labels={p.example.labels} />
  </Section>

  <Section intro={p.definitions.intro} layout="split">
    <ItemList items={p.definitions.items} columns={2} />
  </Section>

  <Section intro={p.inputs.intro} layout="split">
    <ItemList items={p.inputs.items} columns={2} marker="number" />
  </Section>

  <Section intro={p.calculation.intro} layout="split" tone="sunken">
    <ItemList items={p.calculation.items} columns={1} />
  </Section>

  <Section intro={p.methodBoundary.intro} layout="split">
    <ItemList items={p.methodBoundary.items} columns={2} />
  </Section>

  <Section intro={p.exclusions.intro} layout="split">
    <ItemList items={p.exclusions.items} columns={2} marker="cross" />
  </Section>

  <CtaBand intro={p.cta.intro} stepsTitle={p.cta.stepsTitle} steps={p.cta.steps} review={p.cta.review} primary={p.cta.primary} />
</BaseLayout>


